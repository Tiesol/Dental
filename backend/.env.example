DATABASE_URL="postgresql://dental:cambia-esta-password@localhost:5434/dental"
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
# Intentos por minuto y por IP en /auth/login y /auth/register (opcional, por defecto 10)
AUTH_THROTTLE_LIMIT=10
# Zona horaria de la clínica (IANA). Los horarios de atención se interpretan en esta zona.
CLINIC_TIMEZONE=America/La_Paz
PORT=3000
FRONTEND_URL=http://localhost:5173
