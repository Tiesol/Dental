generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Valores en español tal como los nombra el PDF del docente (ver CONVENCIONES.md sección 1).
enum Role {
  PACIENTE
  ODONTOLOGO
  ADMIN
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  EN_ATENCION
  FINALIZADA
  CANCELADA
}

// Usuario base para autenticación. El perfil (Patient o Dentist) lleva los datos de negocio.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PACIENTE)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  patient      Patient?
  dentist      Dentist?
}

model Patient {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  nombre       String
  apellido     String
  telefono     String?
  appointments Appointment[]
}

// Un odontólogo deshabilitado (activo = false) no acepta nuevas citas; su historial se conserva.
model Dentist {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  nombre            String
  especialidad      String
  activo            Boolean            @default(true)
  services          DentistService[]
  availabilityRules AvailabilityRule[]
  unavailableBlocks UnavailableBlock[]
  appointments      Appointment[]
}

// Un servicio deshabilitado (activo = false) no está disponible para nuevas reservas.
model Service {
  id                String           @id @default(uuid())
  nombre            String           @unique
  descripcion       String
  duracionMin       Int
  precioReferencial Decimal?         @db.Decimal(10, 2)
  activo            Boolean          @default(true)
  dentists          DentistService[]
  appointments      Appointment[]
}

// Qué servicios realiza cada odontólogo.
model DentistService {
  dentistId String
  serviceId String
  dentist   Dentist @relation(fields: [dentistId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([dentistId, serviceId])
}

// Horario semanal recurrente de atención.
// diaSemana: 0 = domingo ... 6 = sábado. minutoInicio/minutoFin: minutos desde las 00:00
// en la zona horaria de la clínica (CLINIC_TIMEZONE). Ej.: 09:00 = 540, 12:00 = 720.
model AvailabilityRule {
  id           String  @id @default(uuid())
  dentistId    String
  dentist      Dentist @relation(fields: [dentistId], references: [id])
  diaSemana    Int
  minutoInicio Int
  minutoFin    Int

  @@index([dentistId, diaSemana])
}

// Pausas o bloques puntuales en los que el odontólogo no atiende.
model UnavailableBlock {
  id        String   @id @default(uuid())
  dentistId String
  dentist   Dentist  @relation(fields: [dentistId], references: [id])
  inicio    DateTime @db.Timestamptz(3)
  fin       DateTime @db.Timestamptz(3)
  motivo    String?

  @@index([dentistId, inicio])
}

// Cita. horaFin la calcula el backend (horaInicio + duracionMin del servicio).
// Intervalo semiabierto [horaInicio, horaFin). Además del chequeo en la aplicación,
// la migración agrega un constraint de exclusión en PostgreSQL que impide que dos citas
// activas (estado <> CANCELADA) del mismo odontólogo se solapen.
model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  dentistId   String
  serviceId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  dentist     Dentist           @relation(fields: [dentistId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
  horaInicio  DateTime          @db.Timestamptz(3)
  horaFin     DateTime          @db.Timestamptz(3)
  estado      AppointmentStatus @default(PENDIENTE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  observation Observation?

  @@index([dentistId, horaInicio])
  @@index([patientId, horaInicio])
}

// Observación de atención registrada por el odontólogo al finalizar la cita.
model Observation {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  texto         String
  createdAt     DateTime    @default(now())
}
